CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:add
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one
          blendSrcAlpha: src_alpha
          blendDstAlpha: one
      rasterizerState:
        cullMode: none    
      properties:
        mainTexture:    { value: grey }
        tilingOffset:   { value: [1, 1, 0, 0] }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <cc-global>
  #include <output>
 
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  uniform TexCoords {
    vec4 tilingOffset;
  };

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);
    pos = cc_matViewProj * pos;
    uv0 = a_texCoord * tilingOffset.xy + tilingOffset.zw;
    color = a_color;
    return pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <output>

  in vec4 color;
  uniform sampler2D mainTexture;
  in vec2 uv0;

  vec4 add () {
    vec4 col = 1.0 * color * texture(mainTexture, uv0);
    return CCFragOutput(col);
  }
}%
